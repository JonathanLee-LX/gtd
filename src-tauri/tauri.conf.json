{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTD",
  "version": "0.1.0",
  "identifier": "dev.jonathanleelx.gtd",
  "build": {
    "devUrl": "https://gtd.jonathanleelx.workers.dev",
    "frontendDist": "https://gtd.jonathanleelx.workers.dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GTD",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
